_djvu.xml","source":"derivative","format":"Djvu XML","original":"little-nemo_abbyy.gz","mtime":"1350424402","size":"457722","md5":"af28ca8845b5c134440ba822bb9f5a42","crc32":"e2e464c2","sha1":"8456a8d651eda693d6c4c6a8770c0e5a321c91e6"},{"name":"little-nemo_images.zip","source":"original","format":"Generic Raw Book Zip","mtime":"1350419871","size":"295365105","md5":"2f33e25a8c5bb43eb975a2bc34f822bf","crc32":"bd30740e","sha1":"d597dc4fee841190ea6a1fda2c576e424735cd7a","filecount":"421"},{"name":"little-nemo_jp2.zip","source":"derivative","format":"Single Page Processed JP2 ZIP","original":"little-nemo_images.zip","mtime":"1350420827","size":"321228677","md5":"be071ebcf88c0da384d1b865c7bea1d1","crc32":"d6e163f8","sha1":"634cf61a59e067100e3e81c6353754dad4f80b90","filecount":"421"},{"name":"little-nemo_scandata.xml","source":"derivative","format":"Scandata","original":"little-nemo_djvu.xml","mtime":"1350426451","size":"126416","md5":"fd35d6db724a5b0270de4b810ab06450","crc32":"cd741e9c","sha1":"fd3cdc70c8e693afae2d6910c087bd88457f9f34"},{"name":"preview.jpeg","source":"original","format":"JPEG","mtime":"1300485819","size":"625429","md5":"e5b9ad589272206eaddedd8f8ea6e6c7","crc32":"463ecf88","sha1":"e0f51fa5dc8726386ae9608a8664aaa4abe16e27","rotation":"0"},{"name":"preview_thumb.jpg","source":"derivative","format":"JPEG Thumb","original":"preview.jpeg","mtime":"1300485981","size":"7364","md5":"ed8c00a3abdc3293d78f65fd9dc9ec27","crc32":"fa057550","sha1":"44890742127e7be0363146c667b5534031654ed4"}],"files_count":21,"item_last_updated":1766268398,"item_size":1432489509,"metadata":{"identifier":"LittleNemo1905-1914ByWinsorMccay","title":"Little Nemo 1905-1914 by Winsor McCay","creator":"Winsor McCay","mediatype":"texts","collection":["comics_inbox","comics","folkscanomy"],"description":"The complete first run of Little Nemo, 1905-1914.\n\nScanned for <a href=\"http://comicstriplibrary.org\" rel=\"ugc nofollow\">comicstriplibrary.org</a> from Little Nemo 1905-1914, published by Taschen, ISBN 3822863009","subject":"comics; comic strips; dreams; nightmares","licenseurl":"http://creativecommons.org/publicdomain/mark/1.0/","publicdate":"2011-03-18 22:07:02","addeddate":"2011-03-18 22:04:48","uploader":"zpchavez@gmail.com","updatedate":"2011-03-18 22:08:08","updater":"zpchavez","identifier-access":"http://archive.org/details/LittleNemo1905-1914ByWinsorMccay","identifier-ark":"ark:/13960/t21c3804t","ocr":"ABBYY FineReader 8.0","repub_state":"4","curation":"[curator]malware@archive.org[/curator][date]20140323211923[/date][comment]checked for malware[/comment]","backup_location":"ia903609_7"},"reviews":[{"reviewbody":"Many thanks to Zachary Chavez for scanning and uploading these 421 issues in high resolution. If you love the work of Winsor McCay checking out these is must.","reviewtitle":"Fantastic resource to enjoy the work of Winsor McCay","reviewer":"alanq","reviewdate":"2012-10-15 19:46:14","createdate":"2012-10-15 19:46:14","stars":"5"},{"reviewbody":"I love the work of Winsor, have several books by him and having it in digital form makes me a little bit happier :)","reviewtitle":"Very grateful","reviewer":"Richard7","reviewdate":"2015-04-24 23:16:50","createdate":"2015-04-24 23:16:50","stars":"5"},{"reviewbody":"Once, a cartoonist went to battle for dreamland. It was 1905, hot on the heels of Freud's supremely unsettling The Interpretation of Dreams, and the cartoonist was Winsor McCay. He didn't bring intellectual theories to the fight, but something more potent: beauty. With Little Nemo in Slumberland, his groundbreaking newspaper comic, he presented a dream world that was as sublime as it was reassuring to his Edwardian readers.\n\nNemo rarely gets a good night's sleep, but he certainly isn't tormented by Freudian angst. Instead, his mind overflows with exotic exploits, wonderful creatures straight out of the circuses McCay loved, and companions to share it all with. Ultimately, Nemo always ends up safely back in his bedroom. \"I wish I could sleep without waking up!\" he says in one panel.\n\nFrom NPR Website, written by ETELKA LEHOCZKY\n\nMy thought: Little Nemo in Slumberland was the masterpiece of the pre-modern (modern=20th Century-post WWI) newspaper medium. \nIt's as amazing as Cinemascope was roughly 50 years later, and singular in evocative detail. \nPerhaps Harriman's Krazy Kat and Sendak's best books reach this level of artistry and personal ingenuity. \nLittle Nemo still stands as a truly singular \"graphic novel\" work that enriches each one of us, regardless of age, as we dream along, or share with little ones. \nWonderful!","reviewtitle":"A Quote on Little Nemo in Slumberland by Etelka Lehoczky","reviewer":"Den NC USA","reviewer_itemname":"@den_nc_usa","reviewdate":"2018-08-03 14:37:22","createdate":"2018-08-03 14:30:25","stars":"5"},{"reviewtitle":"Great Archive","reviewbody":"Thank you so much for this! Such a hard-to-find treasure. A high quality scan, too.","stars":"5","reviewer":"Harrison Whitney","reviewdate":"2024-03-21 13:19:11","createdate":"2024-03-21 13:19:11","reviewer_itemname":"@harrison_whitney"}],"server":"ia902900.us.archive.org","uniq":2000718820,"workable_servers":["ia902900.us.archive.org","ia802900.us.archive.org"]}