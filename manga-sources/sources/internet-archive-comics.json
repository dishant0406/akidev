{
  "schema": 1,
  "id": "internet-archive-comics",
  "name": "Internet Archive: public-domain comics",
  "version": 1,
  "lang": ["en"],
  "nsfw": false,
  "base_url": "https://archive.org",
  "user_agent": "AkiManga/1.0",
  "rate_per_second": 2,
  "page_size": 24,
  "popular": {
    "request": { "url": "{base}/advancedsearch.php?q=mediatype%3Atexts+AND+%28subject%3Acomics+OR+subject%3A%22comic+books%22%29+AND+licenseurl%3A*publicdomain*+AND+format%3AScandata&fl%5B%5D=identifier&fl%5B%5D=title&rows=24&page={page}&sort%5B%5D=downloads+desc&output=json" },
    "format": "json",
    "rows": "response.docs",
    "total": "response.numFound",
    "card": {
      "id": "identifier",
      "title": "title",
      "cover": [{ "path": "identifier" }, { "template": "{base}/services/img/{value}" }]
    }
  },
  "latest": {
    "request": { "url": "{base}/advancedsearch.php?q=mediatype%3Atexts+AND+%28subject%3Acomics+OR+subject%3A%22comic+books%22%29+AND+licenseurl%3A*publicdomain*+AND+format%3AScandata&fl%5B%5D=identifier&fl%5B%5D=title&rows=24&page={page}&sort%5B%5D=publicdate+desc&output=json" },
    "format": "json",
    "rows": "response.docs",
    "total": "response.numFound",
    "card": {
      "id": "identifier",
      "title": "title",
      "cover": [{ "path": "identifier" }, { "template": "{base}/services/img/{value}" }]
    }
  },
  "search": {
    "request": { "url": "{base}/advancedsearch.php?q=mediatype%3Atexts+AND+%28subject%3Acomics+OR+subject%3A%22comic+books%22%29+AND+licenseurl%3A*publicdomain*+AND+format%3AScandata+AND+title%3A%28{term}%29&fl%5B%5D=identifier&fl%5B%5D=title&rows=24&page={page}&sort%5B%5D=downloads+desc&output=json" },
    "format": "json",
    "rows": "response.docs",
    "total": "response.numFound",
    "card": {
      "id": "identifier",
      "title": "title",
      "cover": [{ "path": "identifier" }, { "template": "{base}/services/img/{value}" }]
    }
  },
  "detail": {
    "request": { "url": "{base}/metadata/{id}" },
    "format": "json",
    "title": "metadata.title",
    "cover": [{ "path": "metadata.identifier" }, { "template": "{base}/services/img/{value}" }],
    "description": [{ "path": "metadata.description" }, "plain_text"],
    "authors": "metadata.creator",
    "tags": [{ "path": "metadata.subject" }, { "split": ";" }],
    "status": [{ "const": "Completed" }]
  },
  "chapters": {
    "request": { "url": "{base}/metadata/{id}" },
    "format": "json",
    "rows": [{ "path": "metadata" }],
    "chapter": {
      "id": "identifier",
      "title": [{ "const": "Read" }],
      "date": [{ "path": "publicdate" }, { "date": ["iso"] }]
    }
  },
  "pages": {
    "prepare": [
      {
        "request": { "url": "{base}/metadata/{id}" },
        "format": "json",
        "vars": { "scandata": [{ "path": "files" }, { "where": { "path": "format", "equals": "Scandata" } }, { "path": "name" }, "first"] }
      }
    ],
    "request": { "url": "{base}/download/{id}/{scandata}" },
    "images": [{ "css": "page" }, { "attr": "leafnum" }, { "template": "{base}/download/{id}/page/n{value}_w1100.jpg" }],
    "reading": "paged"
  }
}
