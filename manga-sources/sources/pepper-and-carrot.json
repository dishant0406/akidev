{
  "schema": 1,
  "id": "pepper-and-carrot",
  "name": "Pepper&Carrot",
  "version": 1,
  "lang": [
    "en",
    "fr",
    "de",
    "es",
    "it",
    "pt",
    "ja"
  ],
  "nsfw": false,
  "base_url": "https://www.peppercarrot.com",
  "user_agent": "AkiManga/1.0",
  "rate_per_second": 2,
  "settings": [
    {
      "id": "lang",
      "name": "Language",
      "default": "en",
      "options": [
        {
          "value": "en",
          "name": "English"
        },
        {
          "value": "fr",
          "name": "French"
        },
        {
          "value": "de",
          "name": "German"
        },
        {
          "value": "es",
          "name": "Spanish"
        },
        {
          "value": "it",
          "name": "Italian"
        },
        {
          "value": "pt",
          "name": "Portuguese"
        },
        {
          "value": "ja",
          "name": "Japanese"
        }
      ]
    },
    {
      "id": "quality",
      "name": "Picture quality",
      "default": "low-res",
      "options": [
        {
          "value": "low-res",
          "name": "Standard"
        },
        {
          "value": "hi-res",
          "name": "High (larger downloads)"
        }
      ]
    }
  ],
  "popular": {
    "request": {
      "url": "{base}/0_sources/episodes-v1.json"
    },
    "format": "json",
    "rows": [
      {
        "path": ""
      },
      "first"
    ],
    "card": {
      "id": [
        {
          "const": "pepper-and-carrot"
        }
      ],
      "title": [
        {
          "const": "Pepper&Carrot"
        }
      ],
      "cover": [
        {
          "path": "pages.cover"
        },
        {
          "template": "{base}/0_sources/{^.name}/low-res/en_{value}"
        }
      ]
    },
    "total": [
      {
        "const": "1"
      }
    ]
  },
  "detail": {
    "request": {
      "url": "{base}/0_sources/episodes-v1.json"
    },
    "format": "json",
    "title": [
      {
        "const": "Pepper&Carrot"
      }
    ],
    "cover": [
      {
        "path": ""
      },
      "first",
      {
        "path": "pages.cover"
      },
      {
        "template": "{base}/0_sources/ep01_Potion-of-Flight/low-res/en_{value}"
      }
    ],
    "description": [
      {
        "const": "The comedy of a young witch, Pepper, and her cat Carrot, by David Revoy: a free (libre) and open-source webcomic, licensed CC BY 4.0, translated by volunteers."
      }
    ],
    "authors": [
      {
        "const": "David Revoy"
      }
    ],
    "tags": [
      {
        "const": "Fantasy, Comedy"
      },
      {
        "split": ","
      }
    ],
    "status": [
      {
        "const": "Ongoing"
      }
    ]
  },
  "chapters": {
    "request": {
      "url": "{base}/0_sources/episodes-v1.json"
    },
    "format": "json",
    "rows": [
      {
        "path": ""
      }
    ],
    "chapter": {
      "id": "name",
      "number": [
        {
          "path": "name"
        },
        {
          "regex": "^ep0*(\\d+)_"
        }
      ],
      "title": [
        {
          "path": "name"
        },
        {
          "replace": {
            "from": "^ep0*(\\d+)_(.+)$",
            "to": "Episode $1: $2"
          }
        },
        {
          "replace": {
            "from": "-",
            "to": " "
          }
        }
      ]
    },
    "order": "oldest-first"
  },
  "pages": {
    "request": {
      "url": "{base}/0_sources/episodes-v1.json"
    },
    "format": "json",
    "images": [
      {
        "path": ""
      },
      {
        "where": {
          "path": "name",
          "equals": "{id}"
        }
      },
      {
        "path": "pages.*"
      },
      "sort",
      {
        "template": "{base}/0_sources/{id}/{quality}/{lang}_{value}"
      }
    ],
    "reading": "paged"
  }
}
