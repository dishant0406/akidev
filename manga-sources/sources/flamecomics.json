{
  "schema": 1,
  "id": "flamecomics",
  "name": "Flame Comics",
  "version": 1,
  "lang": ["en"],
  "nsfw": false,
  "base_url": "https://flamecomics.xyz",
  "rate_per_second": 2,
  "search": {
    "request": {
      "url": "{base}/api/series?search={term}"
    },
    "format": "json",
    "rows": [
      { "path": "*" }
    ],
    "card": {
      "id": "id",
      "title": "label",
      "cover": [
        { "path": "image" },
        {
          "template": "https://cdn.flamecomics.xyz/uploads/images/series/{^.id}/{value}"
        }
      ]
    }
  },
  "detail": {
    "request": {
      "url": "{base}/series/{id}"
    },
    "title": [
      { "css": "script#__NEXT_DATA__" },
      "html",
      "json",
      { "path": "props.pageProps.series.title" }
    ],
    "cover": [
      { "css": "script#__NEXT_DATA__" },
      "html",
      "json",
      { "path": "props.pageProps.series.cover" },
      {
        "template": "https://cdn.flamecomics.xyz/uploads/images/series/{id}/{value}"
      }
    ],
    "description": [
      { "css": "script#__NEXT_DATA__" },
      "html",
      "json",
      { "path": "props.pageProps.series.description" },
      "plain_text"
    ],
    "authors": [
      { "css": "script#__NEXT_DATA__" },
      "html",
      "json",
      { "path": "props.pageProps.series.author.*" }
    ],
    "tags": [
      { "css": "script#__NEXT_DATA__" },
      "html",
      "json",
      { "path": "props.pageProps.series.tags.*" }
    ],
    "status": [
      { "css": "script#__NEXT_DATA__" },
      "html",
      "json",
      { "path": "props.pageProps.series.status" }
    ]
  },
  "chapters": {
    "request": {
      "url": "{base}/series/{id}"
    },
    "rows": [
      { "css": "script#__NEXT_DATA__" },
      "html",
      "json",
      { "path": "props.pageProps.chapters.*" }
    ],
    "chapter": {
      "id": [{ "path": "token" }],
      "number": [
        { "path": "chapter" },
        "number"
      ],
      "title": [{ "path": "title" }]
    },
    "order": "newest-first"
  },
  "pages": {
    "request": {
      "url": "{base}/series/{series}/{id:raw}"
    },
    "images": [
      { "css": "script#__NEXT_DATA__" },
      "html",
      "json",
      { "path": "props.pageProps.chapter.images.*.name" },
      "sort",
      {
        "template": "https://cdn.flamecomics.xyz/uploads/images/series/{series}/{id:raw}/{value}"
      }
    ],
    "reading": "longstrip"
  },
  "page_size": 20
}
