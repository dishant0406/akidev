{
  "schema": 1,
  "id": "asurascans",
  "name": "Asura Scans",
  "version": 4,
  "lang": [
    "en"
  ],
  "nsfw": false,
  "base_url": "https://api.asurascans.com",
  "rate_per_second": 1,
  "popular": {
    "request": {
      "url": "{base}/api/series?offset={offset}&per_page=20&sort=popular"
    },
    "format": "json",
    "rows": "data",
    "card": {
      "id": "slug",
      "title": "title",
      "cover": "cover"
    },
    "next": "meta.has_more"
  },
  "latest": {
    "request": {
      "url": "{base}/api/series?offset={offset}&per_page=20"
    },
    "format": "json",
    "rows": "data",
    "card": {
      "id": "slug",
      "title": "title",
      "cover": "cover"
    },
    "next": "meta.has_more"
  },
  "search": {
    "request": {
      "url": "{base}/api/series?offset={offset}&per_page=20{?&search={term}?}{?&genre={genre}&sort=popular?}"
    },
    "format": "json",
    "rows": "data",
    "card": {
      "id": "slug",
      "title": "title",
      "cover": "cover"
    },
    "next": "meta.has_more"
  },
  "filters": [
    {
      "id": "genre",
      "name": "Genre",
      "kind": "select",
      "options": [
        { "value": "action", "name": "Action" },
        { "value": "adventure", "name": "Adventure" },
        { "value": "comedy", "name": "Comedy" },
        { "value": "drama", "name": "Drama" },
        { "value": "fantasy", "name": "Fantasy" },
        { "value": "isekai", "name": "Isekai" },
        { "value": "magic", "name": "Magic" },
        { "value": "martial-arts", "name": "Martial Arts" },
        { "value": "murim", "name": "Murim" },
        { "value": "mystery", "name": "Mystery" },
        { "value": "overpowered", "name": "Overpowered" },
        { "value": "regression", "name": "Regression" },
        { "value": "reincarnation", "name": "Reincarnation" },
        { "value": "revenge", "name": "Revenge" },
        { "value": "romance", "name": "Romance" },
        { "value": "school-life", "name": "School Life" },
        { "value": "sci-fi", "name": "Sci-fi" },
        { "value": "shounen", "name": "Shounen" },
        { "value": "slice-of-life", "name": "Slice of Life" },
        { "value": "system", "name": "System" }
      ]
    }
  ],
  "detail": {
    "request": {
      "url": "{base}/api/series/{id}"
    },
    "format": "json",
    "title": "series.title",
    "cover": "series.cover",
    "description": [
      {
        "path": "series.description"
      },
      "plain_text"
    ],
    "authors": "series.author",
    "tags": "series.genres.*.name",
    "status": [
      {
        "path": "series.status"
      },
      {
        "map": [
          [
            "completed",
            "completed"
          ],
          [
            "ongoing",
            "ongoing"
          ],
          [
            "hiatus",
            "hiatus"
          ],
          [
            "cancelled",
            "cancelled"
          ],
          [
            "canceled",
            "cancelled"
          ]
        ]
      },
      {
        "default": "unknown"
      }
    ]
  },
  "chapters": {
    "request": {
      "url": "{base}/api/series/{id}/chapters?page={page}&per_page=100"
    },
    "format": "json",
    "rows": "data",
    "chapter": {
      "id": "slug",
      "number": "number",
      "title": [
        {
          "path": "number"
        },
        {
          "template": "Chapter {value}"
        }
      ],
      "date": [
        {
          "path": "published_at"
        },
        {
          "date": [
            "iso"
          ]
        }
      ]
    },
    "order": "newest-first",
    "repeat": {
      "size": 100
    }
  },
  "pages": {
    "request": {
      "url": "{base}/api/series/{series}/chapters/{id}"
    },
    "format": "json",
    "images": "data.chapter.pages.*.url",
    "reading": "longstrip"
  },
  "page_size": 20
}
