{
  "schema": 1,
  "id": "dynastyscans",
  "name": "Dynasty Scans",
  "version": 2,
  "lang": ["en"],
  "nsfw": true,
  "base_url": "https://dynasty-scans.com",
  "rate_per_second": 2,
  "latest": {
    "request": {
      "url": "{base}/chapters/added.json?page={page}"
    },
    "format": "json",
    "rows": "chapters",
    "card": {
      "id": [
        { "path": "tags" },
        { "where": { "path": "type", "equals": "Series" } },
        { "path": "permalink" },
        { "template": "series/{value}" }
      ],
      "title": "series"
    }
  },
  "search": {
    "request": {
      "url": "{base}/search?{?q={term}&?}classes%5B%5D=Series{?&with%5B%5D={genre}?}{?&classes%5B%5D={type}?}&page={page}"
    },
    "rows": "dl.chapter-list dd",
    "card": {
      "id": [
        { "css": "a.name" },
        { "attr": "href" },
        { "replace": { "from": "^/", "to": "" } }
      ],
      "title": "a.name"
    },
    "next": "a[rel=\"next\"]"
  },
  "filters": [
    {
      "id": "genre",
      "name": "Genre",
      "kind": "select",
      "options": [
        { "value": "5113", "name": "Yuri" },
        { "value": "5120", "name": "Romance" },
        { "value": "5124", "name": "Comedy" },
        { "value": "5150", "name": "Drama" },
        { "value": "5116", "name": "Slice of Life" },
        { "value": "5147", "name": "School Life" },
        { "value": "5128", "name": "Action" },
        { "value": "5146", "name": "Fantasy" },
        { "value": "5179", "name": "NSFW" },
        { "value": "5192", "name": "4-Koma" },
        { "value": "5185", "name": "Age Gap" },
        { "value": "5247", "name": "Childhood Friends" },
        { "value": "5415", "name": "Office Lady" },
        { "value": "19086", "name": "Isekai" },
        { "value": "5172", "name": "Historical" },
        { "value": "9013", "name": "Music" },
        { "value": "5171", "name": "Sci-Fi" },
        { "value": "5166", "name": "Horror" },
        { "value": "5148", "name": "Supernatural" },
        { "value": "5158", "name": "Gender Bender" }
      ]
    },
    {
      "id": "type",
      "name": "Type",
      "kind": "select",
      "options": [
        { "value": "Doujin", "name": "Doujinshi" },
        { "value": "Anthology", "name": "Anthology" }
      ]
    }
  ],
  "detail": {
    "request": {
      "url": "{base}/{id:raw}.json"
    },
    "format": "json",
    "title": "name",
    "cover": "cover",
    "description": [
      { "path": "description" },
      "plain_text"
    ],
    "authors": [
      { "path": "tags" },
      { "where": { "path": "type", "equals": "Author" } },
      { "path": "name" }
    ],
    "tags": [
      { "path": "tags" },
      { "where": { "path": "type", "equals": "General" } },
      { "path": "name" }
    ],
    "status": [
      { "path": "tags" },
      { "where": { "path": "type", "equals": "Status" } },
      { "path": "name" }
    ]
  },
  "chapters": {
    "request": {
      "url": "{base}/{id:raw}.json?page={page}"
    },
    "format": "json",
    "rows": [
      { "path": "taggings" },
      { "where": { "path": "title", "absent": false } }
    ],
    "repeat": { "size": 25 },
    "chapter": {
      "id": "permalink",
      "title": "title",
      "date": [
        { "path": "released_on" },
        { "date": ["yyyy-MM-dd", "iso"] }
      ],
      "scanlator": [
        { "path": "tags" },
        { "where": { "path": "type", "equals": "Scanlator" } },
        { "path": "name" },
        "first"
      ]
    },
    "order": "oldest-first"
  },
  "pages": {
    "request": {
      "url": "{base}/chapters/{id:raw}.json"
    },
    "format": "json",
    "images": "pages.*.url",
    "reading": "paged"
  }
}
