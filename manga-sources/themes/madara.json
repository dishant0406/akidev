{
  "theme": true,
  "version": 1,
  "schema": 1,
  "rate_per_second": 2,
  "popular": {
    "request": {
      "url": "{base}/manga/page/{page}/?m_orderby=views"
    },
    "rows": "div.page-item-detail",
    "card": {
      "id": [
        {
          "css": "h3 a, h5 a, .post-title a"
        },
        {
          "attr": "href"
        },
        {
          "regex": "/manga/([^/]+)/?$"
        }
      ],
      "title": ".post-title a",
      "cover": [
        {
          "css": "img"
        },
        {
          "attr": "data-src|data-lazy-src|src"
        }
      ]
    },
    "next": "a.nextpostslink"
  },
  "latest": {
    "request": {
      "url": "{base}/manga/page/{page}/?m_orderby=latest"
    },
    "rows": "div.page-item-detail",
    "card": {
      "id": [
        {
          "css": ".post-title a"
        },
        {
          "attr": "href"
        },
        {
          "regex": "/manga/([^/]+)/?$"
        }
      ],
      "title": ".post-title a",
      "cover": [
        {
          "css": "img"
        },
        {
          "attr": "data-src|data-lazy-src|src"
        }
      ]
    },
    "next": "a.nextpostslink"
  },
  "search": {
    "request": {
      "url": "{base}/page/{page}/?s={term}&post_type=wp-manga"
    },
    "rows": "div.c-tabs-item__content",
    "card": {
      "id": [
        {
          "css": ".post-title a"
        },
        {
          "attr": "href"
        },
        {
          "regex": "/manga/([^/]+)/?$"
        }
      ],
      "title": ".post-title a",
      "cover": [
        {
          "css": "img"
        },
        {
          "attr": "data-src|data-lazy-src|src"
        }
      ]
    },
    "next": "a.nextpostslink"
  },
  "detail": {
    "request": {
      "url": "{base}/manga/{id}/"
    },
    "title": [
      {
        "css": ".post-title h1"
      },
      "text",
      {
        "replace": {
          "from": "^(HOT|NEW)\\s+",
          "to": ""
        }
      }
    ],
    "cover": [
      {
        "css": ".summary_image img"
      },
      {
        "attr": "data-src|data-lazy-src|src"
      }
    ],
    "description": ".summary__content",
    "authors": ".author-content a",
    "tags": ".genres-content a",
    "status": [
      {
        "css": ".post-status .post-content_item:nth-of-type(2) .summary-content"
      },
      "text",
      {
        "map": [
          [
            "not yet released",
            "upcoming"
          ],
          [
            "upcoming",
            "upcoming"
          ],
          [
            "on hold",
            "hiatus"
          ],
          [
            "ongoing",
            "ongoing"
          ],
          [
            "on going",
            "ongoing"
          ],
          [
            "publishing",
            "ongoing"
          ],
          [
            "completed",
            "completed"
          ],
          [
            "complete",
            "completed"
          ],
          [
            "finished",
            "completed"
          ],
          [
            "ended",
            "completed"
          ],
          [
            "hiatus",
            "hiatus"
          ],
          [
            "cancelled",
            "cancelled"
          ],
          [
            "canceled",
            "cancelled"
          ],
          [
            "dropped",
            "cancelled"
          ],
          [
            "discontinued",
            "cancelled"
          ],
          [
            "مستمرة",
            "ongoing"
          ],
          [
            "مكتملة",
            "completed"
          ],
          [
            "متوقفة",
            "hiatus"
          ],
          [
            "ملغاة",
            "cancelled"
          ]
        ]
      },
      {
        "default": "unknown"
      }
    ]
  },
  "chapters": {
    "request": {
      "method": "POST",
      "url": "{base}/manga/{id}/ajax/chapters/",
      "headers": {
        "x-requested-with": "XMLHttpRequest"
      }
    },
    "rows": "li.wp-manga-chapter",
    "chapter": {
      "id": [
        {
          "css": "a"
        },
        {
          "attr": "href"
        },
        {
          "regex": "/manga/[^/]+/([^/]+)/?$"
        }
      ],
      "title": "a",
      "date": [
        {
          "css": ".chapter-release-date"
        },
        "text",
        {
          "date": [
            "MMMM d, yyyy",
            "MMM d, yyyy",
            "relative"
          ]
        }
      ]
    },
    "order": "newest-first"
  },
  "pages": {
    "request": {
      "url": "{base}/manga/{series}/{id}/"
    },
    "images": [
      {
        "css": "div.page-break img"
      },
      {
        "attr": "data-src|data-lazy-src|src"
      }
    ],
    "reading": "longstrip"
  }
}
