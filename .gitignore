# debrid key, so it must never be committed.
.env.deploy

# Editor and OS
.DS_Store
*.pem

# Local agent tooling state
.kajicode/

# Launch and marketing material, kept out of the repository
marketing/
design/shots/
manga-app/build-rel/
content/manga/film/inputs/
content/manga/film/out/

# Release keys for fastlane (App Store and Google Play)
fastlane/.env
fastlane/report.xml
fastlane/README.md

# The sources document. build.rs downloads it; it is not committed.
content/sources/sources.json
content/sources/sources.json.part

# Build output of the plugins (each is its own Cargo project).
content/plugins/*/target/

# Build output of the Rust workspace, and the sources signing key.
/target/
.secrets/
